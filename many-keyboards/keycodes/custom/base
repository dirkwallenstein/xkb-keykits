default xkb_keycodes "base" {
    include "evdev(evdev)"

    // German hash and return keys
    <RTRN> = 51;  // <BKSL>
    <DALT> = 36;  // <RTRN>

    // rotate on the left counterclockwise
    <MESC> = 66;  // <CAPS>
    <CAPS> = 37;  // <LCTL>
    <LCTL> = 64;  // <LALT>

    // rotate on the bottom (use LVL3 instead of RALT)
    <MYL3> = 133; // <LWIN>
    <MCTL> = 108; // <RALT>
    <MSUP> = 105; // <RCTL>

};
