partial alphanumeric_keys
xkb_symbols "usersymbols" {

    include "de(nodeadkeys)"

    name[Group1]="Folk Unit One (usersymbols)";

    key <DALT> { [  Alt_R             ] };

    key <MYL3> { [  ISO_Level3_Shift  ] };
    key <MALT> { [  Alt_L             ] };
    key <MSUP> { [  Super_L           ] };
    key <MCTL> { [  Control_L         ] };

    // Example configs
    key <TEST> { [    Insert ] };
    key <TSTN> { [         n,       N,              at,         Delete ] };
    key <TSTM> { [         m,       M,        EuroSign,             mu ] };
    key <TSTR> { [         r,       R,     Greek_omega,    Greek_OMEGA ] };
    key <TSTT> { [         t,       T,             eth,            ETH ] };

};
